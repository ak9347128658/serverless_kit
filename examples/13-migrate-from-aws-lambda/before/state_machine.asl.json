{
  "Comment": "BEFORE: hand-written Amazon States Language",
  "StartAt": "Validate",
  "States": {
    "Validate": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:orders-validate",
      "Catch": [{"ErrorEquals": ["ValueError"], "Next": "Rejected", "ResultPath": "$.error"}],
      "Next": "IsLarge"
    },
    "IsLarge": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.total", "NumericGreaterThan": 500, "Next": "Review"}],
      "Default": "Charge"
    },
    "Review": {"Type": "Wait", "Seconds": 60, "Next": "Charge"},
    "Charge": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:orders-charge",
      "Retry": [{"ErrorEquals": ["States.ALL"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2.0}],
      "End": true
    },
    "Rejected": {"Type": "Fail", "Error": "OrderRejected"}
  }
}
