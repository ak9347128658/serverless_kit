{
  "name": "pskit-dashboard-ui",
  "private": true,
  "version": "0.0.0",
  "description": "Source of the py-serverless-kit dashboard. `npm run build` writes src/py_serverless_kit/dashboard/template.html.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/install-template.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  }
}
