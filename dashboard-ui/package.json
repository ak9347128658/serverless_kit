{
  "name": "pskit-dashboard-ui",
  "private": true,
  "version": "0.0.0",
  "description": "Source of the py-serverless-kit dashboard and studio. `npm run build` writes src/py_serverless_kit/dashboard/template.html and src/py_serverless_kit/studio/studio.html.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:studio": "vite --config vite.studio.config.ts",
    "typecheck": "tsc --noEmit",
    "build:dashboard": "vite build && node scripts/install-template.mjs",
    "build:studio": "vite build --config vite.studio.config.ts && node scripts/install-studio.mjs",
    "build": "tsc --noEmit && npm run build:dashboard && npm run build:studio"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  }
}
